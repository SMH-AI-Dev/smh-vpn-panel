#!/usr/bin/env bash
# Open a port in ufw (validated). Installed to /usr/local/sbin, root via sudo.
set -euo pipefail

if [[ $EUID -ne 0 ]]; then
  echo "must run as root" >&2
  exit 1
fi

PORT="${1:-}"
PROTO="${2:-tcp}"

if ! [[ "$PORT" =~ ^[0-9]{1,5}$ ]]; then
  echo "invalid port: $PORT" >&2
  exit 2
fi
if (( PORT < 1 || PORT > 65535 )); then
  echo "port out of range" >&2
  exit 2
fi
if ! [[ "$PROTO" =~ ^(tcp|udp)$ ]]; then
  echo "invalid protocol: $PROTO" >&2
  exit 2
fi

if ! command -v ufw >/dev/null 2>&1; then
  echo "ufw is not installed" >&2
  exit 3
fi

ufw allow "${PORT}/${PROTO}" >/dev/null
echo "opened ${PORT}/${PROTO}"
