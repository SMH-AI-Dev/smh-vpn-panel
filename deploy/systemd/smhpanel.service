[Unit]
Description=SMH Panel - self-hosted VPN management panel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=smhpanel
Group=smhpanel
WorkingDirectory=/opt/smhpanel/app
Environment=SMHPANEL_CONFIG=/etc/smhpanel/config.json
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/smhpanel/venv/bin/python -m smhpanel
Restart=always
RestartSec=3

# Privileged helpers run via sudo and must modify system paths
# (/etc/ufw, /etc/wireguard, /usr/local/etc/xray, /root/.acme.sh), so this unit
# intentionally avoids mount-namespace restrictions. The panel process itself
# still runs as the unprivileged `smhpanel` user; root is reachable only through
# the nine validated helper scripts in /usr/local/sbin via sudoers.
NoNewPrivileges=false

[Install]
WantedBy=multi-user.target
